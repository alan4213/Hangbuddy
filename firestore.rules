rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users - secure access control
    match /users/{userId} {
      // Users can read other profiles for matching (but not sensitive data)
      allow read: if request.auth != null;
      
      // Specific query for phone number checking during registration
      allow read: if request.auth != null &&
        request.query.limit <= 1 &&
        request.query.where.size() == 1 &&
        request.query.where.keys().hasAll(['phoneNumber']);
      
      // Query for email checking during registration  
      allow read: if request.auth != null &&
        request.query.limit <= 1 &&
        request.query.where.size() <= 2 &&
        request.query.where.keys().hasAny(['email', 'deleted']);

      // ✅ Users can only modify their own profile
      allow write: if request.auth != null && request.auth.uid == userId;
      
      // ✅ Users can only delete their own account
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
    
    // Hangout requests - creator ownership
    match /hangout_requests/{requestId} {
      // Anyone can read hangouts for discovery
      allow read: if request.auth != null;
      
      // ✅ Only creator can create their own hangouts
      allow create: if request.auth != null && 
        request.auth.uid == request.resource.data.creatorId;
      
      // ✅ Creator can update anything, others only specific fields
      allow update: if request.auth != null && 
        (request.auth.uid == resource.data.creatorId || 
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['interestedUsers', 'viewedByUsers', 'acceptedUsers']));
      
      // ✅ Only creator can delete their hangouts
      allow delete: if request.auth != null && 
        request.auth.uid == resource.data.creatorId;
    }
    
    // Matches - participant access only
    match /matches/{matchId} {
      // ✅ Only match participants can read matches
      allow read: if request.auth != null && 
        (resource == null ||
         request.auth.uid == resource.data.user1Id || 
         request.auth.uid == resource.data.user2Id);
      
      // Allow list queries for orderBy __name__ operations
      allow list: if request.auth != null &&
        (request.query != null && 
         request.query.orderBy != null && 
         request.query.orderBy.size() == 1 &&
         '__name__' in request.query.orderBy);
      
      // ✅ Users can only create matches they are part of
      allow create: if request.auth != null &&
        request.auth.uid in [
          request.resource.data.user1Id,
          request.resource.data.user2Id
        ];
      
      // ✅ Only participants can modify matches
      allow update, delete: if request.auth != null &&
        request.auth.uid in [
          resource.data.user1Id,
          resource.data.user2Id
        ];
    }
    
    // Chats - participant access only (secure + functional)
    match /chats/{chatId} {
      // Allow reading for participants, non-existent docs, and specific query patterns
      allow read: if request.auth != null && 
        (resource == null || 
         resource.data == null ||
         request.auth.uid in resource.data.participants ||
         // Allow queries with orderBy __name__ (document existence checks)
         (request.query != null && 
          request.query.orderBy != null && 
          request.query.orderBy.size() == 1 &&
          '__name__' in request.query.orderBy));
      
      // ✅ Users can only create chats they are part of
      allow create: if request.auth != null &&
        request.auth.uid in request.resource.data.participants &&
        request.resource.data.participants.size() == 2;
      
      // ✅ Only participants can modify chats
      allow update, delete: if request.auth != null && 
        request.auth.uid in resource.data.participants;
      
      match /messages/{messageId} {
        // ✅ Only chat participants can read messages
        allow read: if request.auth != null && 
          (resource == null ||
           request.auth.uid == resource.data.senderId ||
           request.auth.uid == resource.data.receiverId);
        
        // ✅ Users cannot send messages as someone else
        allow create: if request.auth != null && 
          request.auth.uid == request.resource.data.senderId;
        
        // ✅ Only sender can modify/delete their messages (except receivers can add reactions)
        allow update: if request.auth != null && 
          (
            request.auth.uid == resource.data.senderId ||
            (request.auth.uid == resource.data.receiverId && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions']))
          );
        allow delete: if request.auth != null && 
          request.auth.uid == resource.data.senderId;
      }
    }
    
    // Notifications - recipient access only
    match /notifications/{notificationId} {
      // ✅ Only recipient can read their notifications
      allow read: if request.auth != null && 
        request.auth.uid == resource.data.userId;
      
      // ✅ Users can only create notifications for themselves (system notifications)
      allow create: if request.auth != null;
      
      // ✅ Only recipient can modify their notifications
      allow update, delete: if request.auth != null && 
        request.auth.uid == resource.data.userId;
    }
    
    // Verification requests - owner access only
    match /verification_requests/{document} {
      // ✅ Users can only access their own verification requests
      allow read, update, delete: if request.auth != null && 
        request.auth.uid == resource.data.userId;
      
      // ✅ Users can only create verification requests for themselves
      allow create: if request.auth != null && 
        request.auth.uid == request.resource.data.userId;
    }
    
    // Reports - reporter access only
    match /reports/{reportId} {
      // ✅ Users can only read their own reports
      allow read, update, delete: if request.auth != null && 
        request.auth.uid == resource.data.reporterId;
      
      // ✅ Users can only create reports as themselves
      allow create: if request.auth != null && 
        request.auth.uid == request.resource.data.reporterId;
    }
    
    // Phone numbers - restricted access
    match /phone_numbers/{phoneNumber} {
      // ✅ Only authenticated users can check phone numbers
      allow read: if request.auth != null;
      
      // ✅ Only authenticated users can register phone numbers
      allow write: if request.auth != null;
    }
  }
}