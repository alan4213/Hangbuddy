rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users - can read others for matching, only write own profile
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Hangout requests - only creator can manage, others can read all
    match /hangout_requests/{requestId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && 
        request.auth.uid == request.resource.data.creatorId &&
        request.resource.data.keys().hasAll(['creatorId', 'title', 'category', 'dateTime', 'location', 'status', 'createdAt']);
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.creatorId;
    }
    
    // Matches - all authenticated users can read, only involved users can write
    match /matches/{matchId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && 
        (request.auth.uid == resource.data.user1Id || request.auth.uid == resource.data.user2Id);
    }
    
    // Chats - only participants can access
    match /chats/{chatId} {
      allow read, write: if request.auth != null && 
        request.auth.uid in resource.data.participants;
      
      match /messages/{messageId} {
        allow read, write: if request.auth != null && 
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
      }
    }
    
    // Notifications - only for the recipient
    match /notifications/{notificationId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.userId;
    }
    
    // Verification requests - only own requests
    match /verification_requests/{document} {
      allow read, write, create: if request.auth != null && request.auth.uid == resource.data.userId;
    }
    
    // Reports - only creator can access
    match /reports/{reportId} {
      allow read, write, create: if request.auth != null && request.auth.uid == resource.data.reporterId;
    }
  }
}