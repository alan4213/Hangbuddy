rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users - secure but functional
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Hangout requests - allow specific field updates
    match /hangout_requests/{requestId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.creatorId;
      allow update: if request.auth != null && 
        (request.auth.uid == resource.data.creatorId || 
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['interestedUsers', 'viewedByUsers', 'acceptedUsers']));
      allow delete: if request.auth != null && request.auth.uid == resource.data.creatorId;
    }
    
    // Matches - only participants can access
    match /matches/{matchId} {
      allow read, write: if request.auth != null && 
        (request.auth.uid == resource.data.user1Id || request.auth.uid == resource.data.user2Id);
    }
    
    // Chats - only participants
    match /chats/{chatId} {
      allow read, write: if request.auth != null && 
        request.auth.uid in resource.data.participants;
      
      match /messages/{messageId} {
        allow read, write: if request.auth != null && 
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
      }
    }
    
    // Notifications - only recipient
    match /notifications/{notificationId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null;
    }
    
    // Other collections
    match /verification_requests/{document} {
      allow read, write, create: if request.auth != null && request.auth.uid == resource.data.userId;
    }
    
    match /reports/{reportId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.reporterId;
      allow create: if request.auth != null;
    }
    
    // Phone numbers - restrict to authenticated users
    match /phone_numbers/{phoneNumber} {
      allow read, write: if request.auth != null;
    }
  }
}