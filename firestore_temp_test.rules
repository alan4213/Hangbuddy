rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users - secure access control
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
    
    // Hangout requests - creator ownership
    match /hangout_requests/{requestId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && 
        request.auth.uid == request.resource.data.creatorId;
      allow update: if request.auth != null && 
        (request.auth.uid == resource.data.creatorId || 
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['interestedUsers', 'viewedByUsers', 'acceptedUsers']));
      allow delete: if request.auth != null && 
        request.auth.uid == resource.data.creatorId;
    }
    
    // Matches - simplified for testing
    match /matches/{matchId} {
      allow read, write: if request.auth != null;
    }
    
    // Chats - TEMPORARY SIMPLIFIED RULES FOR TESTING
    match /chats/{chatId} {
      allow read, write: if request.auth != null;
      
      match /messages/{messageId} {
        allow read, write: if request.auth != null;
      }
    }
    
    // Notifications
    match /notifications/{notificationId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }
    
    // Verification requests
    match /verification_requests/{document} {
      allow read, update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
    }
    
    // Reports
    match /reports/{reportId} {
      allow read, update, delete: if request.auth != null && request.auth.uid == resource.data.reporterId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.reporterId;
    }
    
    // Phone numbers
    match /phone_numbers/{phoneNumber} {
      allow read, write: if request.auth != null;
    }
  }
}