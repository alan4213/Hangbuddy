rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users can read and write their own user document
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
      allow delete: if request.auth != null;
    }
    
    // Hangout requests rules
    match /hangout_requests/{requestId} {
      // Anyone authenticated can read hangout requests
      allow read: if request.auth != null;
      
      // Only the creator can create their own hangout requests
      allow create: if request.auth != null && request.auth.uid == request.resource.data.creatorId;
      
      // Anyone can update (for interested users, viewed users)
      allow update: if request.auth != null;
      
      // Only creator can delete their hangout requests
      allow delete: if request.auth != null && request.auth.uid == resource.data.creatorId;
    }
    
    match /matches/{matchId} {
      allow read, write: if request.auth != null;
    }
    
    // Chat rules
    match /chats/{chatId} {
      allow read, write: if request.auth != null;
      
      match /messages/{messageId} {
        allow read, write: if request.auth != null;
      }
    }
    
    // Notifications - only user can access their own notifications
    match /notifications/{notificationId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null;
    }
    
    match /verification_requests/{document} {
      allow read, write, create: if request.auth != null;
    }
    
    match /reports/{reportId} {
      allow read, write, create: if request.auth != null;
    }
  }
}